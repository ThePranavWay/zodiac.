# Store actual values privately in Vercel Production environment variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SIGNING_KEY=REPLACE_WITH_A_PRIVATE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
ORGANIZER_PASSWORD=REPLACE_WITH_A_DIFFERENT_PRIVATE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# ALLOW_LEGACY_RECOVERY is no longer used. Old browser credentials cannot authenticate v2.
# Optional level overrides; leave unset to keep the existing level passwords.
# LEVEL_1_PASSWORD_SHA256=
# LEVEL_2_PASSWORD_SHA256=
# LEVEL_3_PASSWORD_SHA256=
# LEVEL_4_PASSWORD_SHA256=
# Leave unset (Lax) for normal top-level browsing. Set to None ONLY for trusted
# cross-site iframe embedding (e.g. a hosted preview frame); it forces Secure cookies.
# SESSION_COOKIE_SAMESITE=None
